# Optional Groq integration for Whisper transcription and LLM reflections
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3
SENTINEL_EMOTION_MODEL=
SENTENCE_TRANSFORMER_MODEL=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
# SMTP is required for password-reset email; leave unset to show setup guidance.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
